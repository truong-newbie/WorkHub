{
  "info": {
    "name": "WorkHub Hybrid Recommendation V2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "jobId",
      "value": "1"
    },
    {
      "key": "resumeId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Track job view",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/candidate/jobs/{{jobId}}/view",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source\": \"HOME_RECOMMENDATION\",\n  \"sessionId\": \"abc\"\n}"
        }
      }
    },
    {
      "name": "Track job click",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/candidate/jobs/{{jobId}}/click",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source\": \"RECOMMENDATION\",\n  \"position\": 3\n}"
        }
      }
    },
    {
      "name": "Track search keyword",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/candidate/jobs/search-track",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"keyword\": \"java developer\",\n  \"filtersJson\": \"{\\\"location\\\":\\\"hanoi\\\"}\"\n}"
        }
      }
    },
    {
      "name": "Get recommended jobs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/candidate/jobs/recommended?pageNum=1&pageSize=10&explain=true"
      }
    },
    {
      "name": "Get behavior summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/candidate/recommendation/behavior-summary"
      }
    },
    {
      "name": "Create candidate preference",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/candidate/job-preference",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"desiredJobTitle\": \"Java Developer\",\n  \"preferredLocation\": \"Ha Noi\",\n  \"workMode\": \"ONSITE\",\n  \"employmentType\": \"FULL_TIME\",\n  \"candidateLevel\": \"JUNIOR\",\n  \"experienceYears\": 2,\n  \"expectedSalaryMin\": 1000,\n  \"expectedSalaryMax\": 2500,\n  \"skillIds\": [1, 2]\n}"
        }
      }
    },
    {
      "name": "Save favorite job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/job/{{jobId}}/favorite"
      }
    },
    {
      "name": "Apply job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/job/{{jobId}}/apply",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"resumeId\": {{resumeId}},\n  \"coverLetter\": \"I am interested in this role.\"\n}"
        }
      }
    }
  ]
}
