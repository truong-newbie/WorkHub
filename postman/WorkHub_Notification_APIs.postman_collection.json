{
  "info": {
    "name": "WorkHub Notification APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "notification_id",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Get My Notifications",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/notifications?pageNum=1&pageSize=10&sortBy=createdAt&isAscending=false"
      }
    },
    {
      "name": "Unread Count",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/notifications/unread-count"
      }
    },
    {
      "name": "Mark As Read",
      "request": {
        "method": "PUT",
        "url": "{{base_url}}/notifications/{{notification_id}}/read"
      }
    },
    {
      "name": "Mark All As Read",
      "request": {
        "method": "PUT",
        "url": "{{base_url}}/notifications/read-all"
      }
    },
    {
      "name": "Soft Delete Notification",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/notifications/{{notification_id}}"
      }
    }
  ]
}
